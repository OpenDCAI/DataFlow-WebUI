{
  "$comment": [
    "Full stack: everything in the harness profile plus the Vue frontend.",
    "This is the profile the old scripts/setup_all.sh used to install, minus the",
    "implicit user-directory writes, which are now a separate explicit command."
  ],
  "id": "webui",
  "label": "Full WebUI + Harness",
  "description": "The complete DataFlow-Harness stack: visual DAG canvas in the browser, FastAPI backend, MCP server, and all skills. Agent-built pipelines appear on the canvas.",
  "audience": "Users who want the visual canvas and browser-based agent chat.",
  "installs": [
    "Everything in the harness profile",
    "Frontend Node dependencies and a production build (frontend/dist)"
  ],
  "does_not_install": [
    "Agent MCP configuration (run `./install.sh configure-agent` separately)",
    "Any agent CLI (claude / codex / cursor must already be installed)"
  ],
  "writes_outside_repo": [
    "The chosen skills directory only. Agent MCP config is a separate, explicit command."
  ],
  "prerequisites": [
    {
      "id": "python",
      "check": "$DF_PYTHON --version",
      "min": "3.10",
      "reason": "backend runtime"
    },
    {
      "id": "pip",
      "check": "$DF_PYTHON -m pip --version",
      "reason": "installs backend dependencies"
    },
    {
      "id": "node",
      "check": "node -v",
      "min": "20",
      "reason": "builds the frontend"
    },
    {
      "id": "npm",
      "check": "npm -v",
      "reason": "installs frontend dependencies"
    }
  ],
  "skill_layers": [
    "core",
    "harness",
    "standalone"
  ],
  "steps": [
    {
      "id": "dataflow",
      "label": "Install the DataFlow framework",
      "run": "df_pip_install open-dataflow==1.0.10",
      "skip_if": "df_dataflow_framework_ready",
      "produces": "python package: dataflow"
    },
    {
      "id": "backend-deps",
      "label": "Install backend Python dependencies",
      "run": "df_pip_install -r backend/requirements.txt",
      "produces": "python packages: fastapi, uvicorn, ray, ..."
    },
    {
      "id": "frontend-build",
      "label": "Install frontend dependencies and build the canvas",
      "run": "df_build_frontend",
      "skip_if": "test -f frontend/dist/index.html",
      "produces": "frontend/dist/"
    },
    {
      "id": "dataflow-core",
      "label": "Initialize the DataFlow core data directory",
      "run": "df_init_dataflow_core",
      "skip_if": "df_dataflow_core_ready",
      "produces": "backend/data/dataflow_core/"
    },
    {
      "id": "generate-skills",
      "label": "Render skills for Claude, Codex and Cursor from canonical sources",
      "run": "$DF_PYTHON installers/generate_agent_assets.py --profile webui --agent all --out \"$DF_STAGING\"",
      "produces": "$DF_STAGING/{.claude/skills, .cursor/skills, .cursor/rules, .codex/skills, AGENTS.md}"
    },
    {
      "id": "install-skills",
      "label": "Copy skills into the target skills directory",
      "run": "df_install_skills core harness standalone",
      "produces": "$DF_SKILLS_TARGET"
    },
    {
      "id": "install-agent-assets",
      "label": "Install Cursor, Codex and shared agent assets into this repo",
      "run": "df_install_agent_assets",
      "produces": ".cursor/skills/, .cursor/rules/<skill>.mdc, .codex/skills/, AGENTS.md"
    }
  ],
  "verify": [
    {
      "id": "backend-imports",
      "label": "Backend imports cleanly (app.main)",
      "run": "df_verify_backend_import"
    },
    {
      "id": "frontend-built",
      "label": "Frontend build output exists",
      "run": "df_verify_frontend_dist"
    },
    {
      "id": "mcp-tools-declared",
      "label": "MCP server declares its tool whitelist",
      "run": "df_verify_mcp_whitelist"
    },
    {
      "id": "skills-present",
      "label": "Every installed skill has a readable SKILL.md",
      "run": "df_verify_skills"
    },
    {
      "id": "agent-assets-present",
      "label": "Codex and Cursor assets were generated",
      "run": "df_verify_agent_assets"
    }
  ],
  "must_not_touch": [
    "backend/app",
    "frontend/src",
    ".mcp.json",
    "~/.codex/config.toml",
    "~/.cursor/mcp.json"
  ],
  "next_steps": [
    "Start the backend: ./scripts/start.sh",
    "Open the canvas: http://localhost:8000/",
    "Point an agent at it: ./install.sh configure-agent --agent claude"
  ]
}
